PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-min-32-chars-for-production

DATABASE_FILE=./data/edu.db
UPLOADS_DIR=./data/uploads
LIBRARY_DIR=./data/library
PRIVATE_FILES_DIR=./data/private-files

# production: required for mutating /api requests (csrf guard)
# example: https://enoobis.ru
CORS_ORIGIN=

# only when no admin exists yet (never committed with real values)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# google ai studio key — course tutor chat only (no lecture generation)
GEMINI_API_KEY=
# chat uses the cheapest flash-lite; GEMINI_MODEL is unused unless you add other ai jobs
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# only if google api is unreachable from the server region
GEMINI_BASE_URL=
AI_CHAT_DAILY_LIMIT=40

# daily it news (3 posts, perplexity sonar)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
NEWS_TZ=Asia/Almaty
