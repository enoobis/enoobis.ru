    "highlight.js": "^11.11.1",
    "hover-effect": "^1.2.1",
    "jsqr": "^1.4.0",
    "leaflet": "^1.9.4",
    "marked": "^18.0.0",
    "motion-v": "^2.3.0",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^2.2.6",
    "qrcode": "^1.5.4",
    "three": "^0.184.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.184.1",
